# ===============================================================
# XENOMORPH — Comprehensive .gitignore
# Target: ESP-IDF + Arduino + C/C++ dual-firmware project
# ===============================================================

# ---------- Operating System Metadata ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_view.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- Local Claude / IDE state ----------
.claude/
.history/
.vscode/
.vscode-test/
.idea/

# ===============================================================
# ESP-IDF (Muscle firmware) — root directory
# ===============================================================

# Build output
build/
build_*/
dist/

# ESP-IDF SDK configuration files (regenerated by menuconfig / idf.py)
sdkconfig
sdkconfig.old
sdkconfig.bk
sdkconfig.defaults
sdkconfig.defaults.bk
sdkconfig.old.bk
project.config

# ESP-IDF component management cache
managed_components/
dependencies.lock

# ESP-IDF log & flash artifacts
*.elf
*.map
*.bin
*.uf2
*.hex
*.factory.bin
*.merged.bin
*.ota.bin
flash_project_args
flash_app_args
*_flashing_args
esptool_py/

# ESP-IDF cache directories
.cache/
.cmake/
.gdbinit

# ===============================================================
# Arduino (Commander firmware) — xenomorph_commander_s3/
# ===============================================================

xenomorph_commander_s3/build/
xenomorph_commander_s3/.build/
xenomorph_commander_s3/.cache/
xenomorph_commander_s3/Intermediate/

# Arduino binary outputs
*.ino.cpp
*.ino.hex
*.ino.elf
*.ino.bin
*.ino.map

# Arduino temp / scratch
/tmp/
/Temp/
/sketch/
sketch_jul29a/
sketch_jul29b/
sketch_aug01a/

# Arduino IDE cache
.arduino/
arduino_cache/
arduinoIDE_*/

# ===============================================================
# C/C++ general build artifacts
# ===============================================================

*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out
*.app
*.ipa
*.apk
*.class
*.pyc
*.pyo
*.pyd
*.gch
*.pch

# CMake / Ninja
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
build.ninja
.ninja_deps
.ninja_log
rules.ninja
compile_commands.json

# ===============================================================
# Sensitive / per-developer state
# ===============================================================
secrets.h
secrets.cpp
secrets.ini
.env
.env.local
config.local.h
wifi_credentials.h
*.local

# ===============================================================
# Documentation build outputs
# ===============================================================
doc/api/
doc/html/
doc/latex/
*.aux
*.log
*.toc
*.synctex.gz

# ===============================================================
# Node.js / Python deps (if any helper scripts added later)
# ===============================================================
node_modules/
__pycache__/
*.egg-info/
.venv/
venv/

# ===============================================================
# Misc
# ===============================================================
*.bak
*.swp
*.swo
*~
*.tmp
*.orig
*.rej
core.*
*.log
nul
conftest.pyc